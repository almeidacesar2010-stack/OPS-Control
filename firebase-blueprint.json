{
  "entities": {
    "serviceOrder": {
      "title": "Service Order",
      "description": "Represents a maintenance service order for an equipment.",
      "type": "object",
      "properties": {
        "equipmentNumber": {
          "type": "string",
          "description": "The unique identifier of the equipment."
        },
        "family": {
          "type": "string",
          "enum": ["CCUs", "Tanques de 1500L", "Tanques de 5000/5200L", "Outros"],
          "description": "The type or family of the equipment."
        },
        "subFamily": {
          "type": "string",
          "description": "The sub-family or model of the equipment (e.g., Mini Container, Cesta 12m)."
        },
        "clientId": {
          "type": "string",
          "description": "The ID of the client associated with this OS."
        },
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "The start date of the maintenance."
        },
        "endDate": {
          "type": "string",
          "format": "date-time",
          "description": "The end date of the maintenance."
        },
        "status": {
          "type": "string",
          "enum": ["Em Andamento", "Concluído"],
          "description": "The current status of the OS."
        },
        "leadTime": {
          "type": "number",
          "description": "Number of days between start and end date."
        },
        "userId": {
          "type": "string",
          "description": "The UID of the user who created the OS."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The creation timestamp."
        },
        "slingCheck": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["OK", "NA"] },
            "value": { "type": "string" }
          },
          "description": "Check for Sling (Eslinga)."
        },
        "damagedSlingCheck": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["OK", "NA"] },
            "value": { "type": "string" }
          },
          "description": "Check for Damaged Sling."
        },
        "excessiveCorrosionCheck": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["OK", "NA"] },
            "value": { "type": "string" }
          },
          "description": "Check for Excessive Corrosion."
        },
        "primaryStructureCheck": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["OK", "NA"] },
            "value": { "type": "string" }
          },
          "description": "Check for Primary Structure."
        },
        "secondaryStructureCheck": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["OK", "NA"] },
            "value": { "type": "string" }
          },
          "description": "Check for Secondary Structure."
        },
        "damagedBagCheck": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["OK", "NA"] },
            "value": { "type": "string" }
          },
          "description": "Check for Damaged Bag."
        },
        "reworkCheck": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["OK", "NA"] },
            "value": { "type": "string" }
          },
          "description": "Check for Rework."
        }
      },
      "required": ["equipmentNumber", "family", "clientId", "startDate", "status", "userId"]
    },
    "client": {
      "title": "Client",
      "description": "Represents a customer with CNPJ and Reason Social.",
      "type": "object",
      "properties": {
        "cnpj": {
          "type": "string",
          "description": "The CNPJ of the client."
        },
        "razaoSocial": {
          "type": "string",
          "description": "The legal name of the client."
        },
        "userId": {
          "type": "string",
          "description": "The UID of the user who created the client."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The creation timestamp."
        }
      },
      "required": ["cnpj", "razaoSocial", "userId"]
    },
    "appUser": {
      "title": "App User",
      "description": "Represents an authorized user of the system.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "The email of the user."
        },
        "name": {
          "type": "string",
          "description": "The name of the user."
        },
        "role": {
          "type": "string",
          "enum": ["moderator", "admin", "user"],
          "description": "The role of the user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The creation timestamp."
        }
      },
      "required": ["email", "name", "role", "createdAt"]
    },
    "equipment": {
      "title": "Equipment",
      "description": "Represents a physical asset or container.",
      "type": "object",
      "properties": {
        "tag": {
          "type": "string",
          "description": "The unique tag identifier (e.g., EQ-123)."
        },
        "family": {
          "type": "string",
          "enum": ["CCUs", "Tanques de 1500L", "Tanques de 5000/5200L", "Outros"],
          "description": "The type or family of the equipment."
        },
        "subFamily": {
          "type": "string",
          "description": "The sub-family/model (optional)."
        },
        "userId": {
          "type": "string",
          "description": "The creator UID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The creation timestamp."
        }
      },
      "required": ["tag", "family", "userId", "createdAt"]
    },
    "decontaminationOperation": {
      "title": "Decontamination Operation",
      "description": "Represents a decontamination operation performed on a tank equipment.",
      "type": "object",
      "properties": {
        "equipmentNumber": {
          "type": "string",
          "description": "The equipment tank number (from fleet)."
        },
        "model": {
          "type": "string",
          "description": "The model/type of tank auto-populated from Fleet Management."
        },
        "client": {
          "type": "string",
          "description": "Client name associated with the operation."
        },
        "product": {
          "type": "string",
          "description": "Product or content in the tank."
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Invoice number (Nota Fiscal) of entry."
        },
        "arrivalDate": {
          "type": "string",
          "format": "date-time",
          "description": "Arrival date at base."
        },
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "Decontamination start date."
        },
        "endDate": {
          "type": "string",
          "format": "date-time",
          "description": "Decontamination completion date."
        },
        "hasContamination": {
          "type": "boolean",
          "description": "Indicates whether contamination was detected."
        },
        "notes": {
          "type": "string",
          "description": "General observations."
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "in_progress", "completed"],
          "description": "Current status of the decontamination operation."
        },
        "userId": {
          "type": "string",
          "description": "UID of the user who registered the operation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        }
      },
      "required": ["equipmentNumber", "model", "client", "arrivalDate", "hasContamination", "status"]
    },
    "decontaminationCertificate": {
      "title": "Decontamination Certificate",
      "description": "Official certificate of tank decontamination and cleaning.",
      "type": "object",
      "properties": {
        "reportNumber": { "type": "string" },
        "client": { "type": "string" },
        "status": { "type": "string" },
        "approvalStatus": { "type": "string" },
        "technicalOpinion": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportNumber", "client", "status"]
    },
    "checklist": {
      "title": "Operational Checklist",
      "description": "Represents an independent technical operational checklist for equipment.",
      "type": "object",
      "properties": {
        "checklistType": { "type": "string" },
        "equipmentFamily": { "type": "string" },
        "equipmentModel": { "type": "string" },
        "equipmentTag": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "inspectionDate": { "type": "string", "format": "date-time" },
        "inspectionLocation": { "type": "string" },
        "inspectorName": { "type": "string" },
        "status": { "type": "string", "enum": ["Rascunho", "Em preenchimento", "Concluído", "Reprovado / Com NC"] },
        "modelType": { "type": "string" },
        "conforme": { "type": "boolean" },
        "ncCount": { "type": "number" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["checklistType", "equipmentFamily", "equipmentTag", "clientName", "inspectionDate", "inspectorName", "status", "userId"]
    }
  },
  "firestore": {
    "/serviceOrders/{osId}": {
      "schema": "serviceOrder",
      "description": "Collection of service orders."
    },
    "/checklists/{checklistId}": {
      "schema": "checklist",
      "description": "Collection of independent operational checklists."
    },
    "/clients/{clientId}": {
      "schema": "client",
      "description": "Collection of clients."
    },
    "/users/{userId}": {
      "schema": "appUser",
      "description": "Collection of authorized users."
    },
    "/equipments/{equipmentId}": {
      "schema": "equipment",
      "description": "Collection of registered equipments."
    },
    "/decontaminationOperations/{decontaminationId}": {
      "schema": "decontaminationOperation",
      "description": "Collection of decontamination operations."
    },
    "/decontaminationCertificates/{certId}": {
      "schema": "decontaminationCertificate",
      "description": "Collection of decontamination certificates."
    }
  }
}
