rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // STRICT MODERATOR CHECK: Only users with role == 'moderator' or superadmin
    function isModerator() {
      return isAuthenticated() &&
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator') ||
          (request.auth.token.email != null && request.auth.token.email == "almeidacesar2010@gmail.com")
        );
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['moderator', 'admin']) ||
          (request.auth.token.email != null && request.auth.token.email == "almeidacesar2010@gmail.com")
        );
    }

    match /users/{userId} {
      allow read: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAuthenticated() && isModerator();
    }

    match /fleetEquipment/{fleetId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && isModerator();
    }

    match /fleetHistory/{historyId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /decontaminationOperations/{opId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && isModerator();
    }

    match /serviceOrders/{osId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && isModerator();
    }

    match /equipments/{equipmentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && isModerator();
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && isModerator();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && isModerator();
    }

    match /deletionRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isModerator();
    }

    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
